# ---- 构建产物：dist 目录整体不上传 git ----
# APK 与源码包由 README/发行版页面分发，不纳入版本库。
dist/
.build/
*.keystore
*.jks
*.apk
*.idsig

# ---- 版本单一来源：这两个文件必须能提交，不要忽略 ----
!VERSION
!android/app/src/main/assets/web/version.js

# ---- Python ----
__pycache__/
*.pyc
*.py[cod]
.venv/
venv/
*.egg-info/

# ---- JS ----
node_modules/
package-lock.json

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
*.iml
.DS_Store
Thumbs.db
desktop.ini

# ---- 临时文件 ----
*.log
*.tmp
shots/
